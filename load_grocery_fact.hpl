  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    s.TransactionID,
    c.Customer_Key,
    d.Date_ID,
    p.Product_ID,
    st.Store_ID,
    pm.Payment_ID,
    s.Quantity,
    s.UnitPrice,
    s.TotalAmount AS Sales_Amount
FROM Staging_Grocery_Sales s
JOIN Dim_Customer c
    ON s.CustomerID = c.CustomerID
JOIN Dim_Date d
    ON s.`Date` = d.Full_Date
JOIN Dim_Product p
    ON TRIM(s.Item) = p.Item
   AND TRIM(s.Category) = p.Category
JOIN Dim_Store st
    ON TRIM(s.Store) = st.Store_Name
JOIN Dim_PaymentMethod pm
    ON TRIM(s.PaymentMethod) = pm.PaymentMethod;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>GroceryDW_MySQL</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>224</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
